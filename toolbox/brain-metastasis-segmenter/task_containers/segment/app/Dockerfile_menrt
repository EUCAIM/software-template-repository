FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime
RUN apt-get -y update
RUN apt-get -y install git
RUN apt-get -y install gcc
RUN apt-get -y install nano

COPY ./kmeans-cluster-artifacts /project/kmeans-cluster-artifacts
COPY ./requirements.txt /project/requirements.txt

COPY ./install_nnunet.sh /project/install_nnunet.sh
COPY ./install_mednext.sh /project/install_mednext.sh
RUN bash /project/install_nnunet.sh
RUN bash /project/install_mednext.sh
RUN pip3 install --no-cache-dir -r /project/requirements.txt
RUN pip3 install --upgrade --force-reinstall numpy

COPY ./weights/BraTS2024-MEN-RT_nnUNetv2_model.zip  /project/weights/
